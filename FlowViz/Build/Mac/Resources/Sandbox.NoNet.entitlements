<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  NO APP SANDBOX. FlowViz is a desktop analysis tool whose whole job is
	  reading case directories wherever the user keeps them. Sandboxed, the
	  Browse dialog is silently denied (no user-selected-files entitlement)
	  and even a TYPED path outside the container refuses to load - the demo
	  only worked because the sample ships inside the bundle. The engine
	  template enabled the sandbox by default; this file is named for the
	  slot it fills, not for what it grants.
	-->
	<key>com.apple.security.network.client</key>
	<true/>
	<key>com.apple.security.network.server</key>
	<true/>
</dict>
</plist>
