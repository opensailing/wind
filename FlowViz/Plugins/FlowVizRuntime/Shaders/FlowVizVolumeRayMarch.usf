// Copyright FlowViz contributors. All Rights Reserved.
//
// The scientific volume ray-marcher (ADR 002 Candidate C, plan.md section 9).
//
// WHAT THIS SHADER IS. One compute pass that walks a ray per output pixel
// through a persistent RHI 3D texture uploaded by Render/FlowVizVolumeTexture.*,
// and writes two targets:
//
//   OutColor  RGBA  the image.
//   OutValue  RGBA  (ReportedScalar, Alpha, StatusBits, StepCount) -- the
//                   quantitative answer, the coverage, why a pixel is invalid,
//                   and how many samples the ray actually took.
//
// OutValue IS NOT A DEBUG CHANNEL. It is how the Scientific profile is checked.
//   - VISUAL_QA rule 1 says lighting must not modulate apparent scalar value.
//     OutValue.x is produced before any lighting term is applied, so
//     "lighting on" and "lighting off" must produce a BIT-IDENTICAL OutValue.x.
//     That is a differential assertion a test can fail, rather than an eyeball
//     judgement about brightness.
//   - OutValue.w is the step count. The ray-march step is StepVoxels *
//     MinVoxelSpacing; on the mock domain MinVoxelSpacing is 0.0416667 and
//     MaxVoxelSpacing is 0.09375, so a shader that reached for the wrong one
//     changes the step count by 2.25x and the test says so. Undersampling the
//     thinnest axis is otherwise invisible until it aliases.
//   - OutValue.z carries FLOWVIZ_REASON_* bits, so "this pixel is magenta"
//     and "this pixel is magenta BECAUSE the voxel was NaN" are different
//     assertions and the second one is the checkable one.
//
// THE CONSTANT BLOCK BELOW MIRRORS FFlowVizVolumeShaderParameters ROW FOR ROW.
// That struct pins all ten 16-byte rows with static_asserts (the bottom of
// Render/FlowVizVolumeTexture.h) and FlowVizVolumeRayMarchShader.h re-pins them
// against the SHADER_PARAMETER block. Drift there produces a shader reading
// spacing out of the dimensions slot: a wrong volume that renders plausibly.
// FLOWVIZ_MODE_DIAGNOSTIC echoes every member back through the GPU so a test
// can compare all ten rows against the CPU values rather than trusting the
// assertions to have been written correctly.
//
// FAIL CLOSED. bHasStatusTexture == 0 means REJECT EVERY VOXEL. It does not
// mean "no status was bound, so everything is fine" -- see the member comment
// in FlowVizVolumeTexture.h. That is the branch most likely to be written
// backwards, because backwards renders a complete, plausible image.

#include "/Engine/Public/Platform.ush"
#include "/Plugin/FlowViz/FlowVizCommon.ush"

/* -------------------------------------------------------------------------- */
/* Compositing modes -- must match EFlowVizCompositeMode                        */
/* -------------------------------------------------------------------------- */

#define FLOWVIZ_MODE_ALPHA       0
#define FLOWVIZ_MODE_MAXIMUM     1
#define FLOWVIZ_MODE_MINIMUM     2
#define FLOWVIZ_MODE_AVERAGE     3
#define FLOWVIZ_MODE_ISOSURFACE  4
#define FLOWVIZ_MODE_DIAGNOSTIC  5

/* Component selection -- must match EFlowVizComponentMode. */
#define FLOWVIZ_COMPONENT_MAGNITUDE 4

/* Why a sample was refused, or how it fell outside the transfer function.
   Reported in OutValue.z so a colour assertion can also name its cause. */
#define FLOWVIZ_REASON_NONE        0u
#define FLOWVIZ_REASON_VALID       1u
#define FLOWVIZ_REASON_UNKNOWN     2u   /* status 0, or no status texture bound */
#define FLOWVIZ_REASON_MASKED      4u
#define FLOWVIZ_REASON_NAN         8u
#define FLOWVIZ_REASON_INFINITE    16u
#define FLOWVIZ_REASON_UNDER_RANGE 32u
#define FLOWVIZ_REASON_OVER_RANGE  64u

/* Status bits in the R8_UINT status texture -- must match FlowVizVoxelStatus. */
#define FLOWVIZ_STATUS_VALID    1u
#define FLOWVIZ_STATUS_NAN      2u
#define FLOWVIZ_STATUS_INFINITE 4u
#define FLOWVIZ_STATUS_MASKED   8u

#define FLOWVIZ_MAX_CLIP_PLANES 6

/* -------------------------------------------------------------------------- */
/* Row-for-row mirror of FFlowVizVolumeShaderParameters                         */
/* -------------------------------------------------------------------------- */

float3 GridOrigin;              float  OriginNarrowingError;   /* row 0 */
float3 PhysicalSize;            float  VoxelVolume;            /* row 1 */
float3 VoxelSpacing;            float  MinVoxelSpacing;        /* row 2 */
float3 InvVoxelSpacing;         float  MaxVoxelSpacing;        /* row 3 */
int3   VolumeDimensions;        int    ComponentCount;         /* row 4 */
float3 InvVolumeDimensions;     int    TextureComponentCount;  /* row 5 */
float3 UVWScale;                uint   AssociationCode;        /* row 6 */
float3 UVWBias;                 uint   DataTypeCode;           /* row 7 */
uint   RequiredStatusMask;      uint   InvalidStatusMask;      /* row 8 */
uint   bHasStatusTexture;       uint   bHasVectorTexture;
float  ValueRangeMin;           float  ValueRangeMax;          /* row 9 */
uint   bRejectNonFinite;        uint   PadElementBits;

/* -------------------------------------------------------------------------- */
/* Camera                                                                       */
/* -------------------------------------------------------------------------- */
/*
 * Everything is in LOCAL volume space: [0, PhysicalSize] in solver units with
 * the grid's minimum corner at the origin. World placement is the proxy's
 * double-precision LocalToWorld and deliberately never reaches this shader --
 * a kilometre-scale case would lose metres to float32 here.
 */

float3 RayCameraOrigin;   float RayCameraPad0;
float3 RayCameraForward;  float RayCameraPad1;
float3 RayCameraRight;    float RayCameraPad2;
float3 RayCameraUp;       float RayCameraPad3;
float2 TanHalfFov;        float2 OrthoHalfExtent;
uint   bOrthographic;     uint  OutputSizeX;  uint OutputSizeY;  uint JitterSeed;

/* -------------------------------------------------------------------------- */
/* Marching and styling                                                         */
/* -------------------------------------------------------------------------- */

float StepVoxels;            /* sample step in VOXEL units; scaled by MinVoxelSpacing */
float OpacityMultiplier;
float IsoValue;
float EarlyTerminationAlpha;

float JitterAmount;          /* fraction of one step, [0,1] */
float AmbientStrength;
float DiffuseStrength;
float ReferenceStepVoxels;   /* opacity is corrected to this step so the image is step-invariant */

uint  MaxSteps;
uint  CompositeMode;
uint  ComponentMode;
uint  bEnableJitter;

uint  bEnableLighting;
uint  bFilterField;
uint  bStrictStatusFilter;   /* reject a filtered sample if ANY of its 8 corners is invalid */
uint  NumClipPlanes;

float3 CropBoxMin;   float CropPad0;   /* normalised [0,1] fractions of PhysicalSize */
float3 CropBoxMax;   float CropPad1;
float3 LightDirection; float LightPad0;

float4 ClipPlanes[FLOWVIZ_MAX_CLIP_PLANES];  /* keep dot(N, LocalPos) + D >= 0 */

float4 NaNColor;
float4 MaskedColor;
float4 NoDataColor;
float4 UnderRangeColor;
float4 OverRangeColor;

/* -------------------------------------------------------------------------- */
/* Resources                                                                    */
/* -------------------------------------------------------------------------- */

#if FLOWVIZ_FIELD_UINT
	// An integer field texture. NEVER a UNORM -- see FlowVizCommon.ush. Integer
	// formats cannot be hardware filtered on any target this ships to, so these
	// are point sampled and bFilterField is ignored.
	Texture3D<uint4> FieldTexture;
#else
	Texture3D<float4> FieldTexture;
#endif

Texture3D<uint4>  StatusTexture;
Texture2D<float4> TransferFunctionTexture;

SamplerState FieldSampler;
SamplerState TransferFunctionSampler;

RWTexture2D<float4> OutColor;
RWTexture2D<float4> OutValue;

/* -------------------------------------------------------------------------- */
/* Sampling                                                                     */
/* -------------------------------------------------------------------------- */

/** Local position -> texture UVW. UVWScale/UVWBias already carry the half-voxel
 *  and the point/cell association; recomputing either here would reintroduce the
 *  single most common visualisation error. */
float3 FlowVizLocalToUVW(float3 LocalPos)
{
	return LocalPos * UVWScale + UVWBias;
}

/** UVW -> the integer texel that contains it. */
int3 FlowVizUVWToTexel(float3 UVW)
{
	const int3 Texel = int3(floor(UVW * float3(VolumeDimensions)));
	return clamp(Texel, int3(0, 0, 0), VolumeDimensions - int3(1, 1, 1));
}

/** One raw voxel, point sampled, in whatever channels the texture carries. */
float4 FlowVizLoadRaw(int3 Texel)
{
#if FLOWVIZ_FIELD_UINT
	// The stored integer, converted here where the conversion is visible. A
	// UNORM sampler would have handed us value/255 silently.
	return float4(FieldTexture.Load(int4(Texel, 0)));
#else
	return FieldTexture.Load(int4(Texel, 0));
#endif
}

/** One voxel, filtered when the format and the caller both allow it. */
float4 FlowVizFetchRaw(float3 UVW)
{
#if FLOWVIZ_FIELD_UINT
	return FlowVizLoadRaw(FlowVizUVWToTexel(UVW));
#else
	if (bFilterField != 0)
	{
		return FieldTexture.SampleLevel(FieldSampler, UVW, 0);
	}
	return FlowVizLoadRaw(FlowVizUVWToTexel(UVW));
#endif
}

/**
 * Collapse a voxel to the scalar being coloured.
 *
 * GATED ON ComponentCount, NOT TextureComponentCount. A 3-component field is
 * widened to 4 channels on upload and the pad channel carries a quiet NaN
 * (FLOWVIZ_PAD_IS_NAN), so reading .w of a widened field yields NaN by design.
 * The clamp below is what keeps a mis-set ComponentMode from doing that.
 */
float FlowVizExtractScalar(float4 Raw)
{
	const int Count = max(ComponentCount, 1);

	if (ComponentMode == FLOWVIZ_COMPONENT_MAGNITUDE)
	{
		float SumSq = Raw.x * Raw.x;
		if (Count > 1) { SumSq += Raw.y * Raw.y; }
		if (Count > 2) { SumSq += Raw.z * Raw.z; }
		if (Count > 3) { SumSq += Raw.w * Raw.w; }
		return sqrt(SumSq);
	}

	const int Index = clamp((int)ComponentMode, 0, Count - 1);
	if (Index == 0) { return Raw.x; }
	if (Index == 1) { return Raw.y; }
	if (Index == 2) { return Raw.z; }
	return Raw.w;
}

/** The status byte of the texel containing UVW. Unknown when nothing is bound. */
uint FlowVizLoadStatus(float3 UVW)
{
	// FAIL CLOSED. No status texture means we cannot tell valid from invalid,
	// and "cannot tell" is not "valid".
	if (bHasStatusTexture == 0)
	{
		return 0u;
	}
	return StatusTexture.Load(int4(FlowVizUVWToTexel(UVW), 0)).x;
}

/** Status bits -> the reason a sample was refused. */
uint FlowVizStatusToReason(uint Status)
{
	if ((Status & RequiredStatusMask) == RequiredStatusMask && RequiredStatusMask != 0u)
	{
		return FLOWVIZ_REASON_VALID;
	}
	uint Reason = 0u;
	if ((Status & FLOWVIZ_STATUS_MASKED) != 0u)   { Reason |= FLOWVIZ_REASON_MASKED; }
	if ((Status & FLOWVIZ_STATUS_NAN) != 0u)      { Reason |= FLOWVIZ_REASON_NAN; }
	if ((Status & FLOWVIZ_STATUS_INFINITE) != 0u) { Reason |= FLOWVIZ_REASON_INFINITE; }
	if (Reason == 0u)
	{
		// Status 0 is "nothing was ever written here", which is absent, not zero.
		Reason = FLOWVIZ_REASON_UNKNOWN;
	}
	return Reason;
}

/**
 * Every corner that a trilinear fetch would touch must be valid, or the filtered
 * value is a blend of data and non-data and there is no honest number to report.
 * Off by default because it costs eight loads; on when the case has enough
 * invalid cells for the boundary to matter.
 */
uint FlowVizStrictCornerReason(float3 UVW)
{
	const float3 Coord = UVW * float3(VolumeDimensions) - 0.5f;
	const int3 Base = int3(floor(Coord));

	uint Reason = 0u;
	UNROLL
	for (int Corner = 0; Corner < 8; ++Corner)
	{
		const int3 Offset = int3(Corner & 1, (Corner >> 1) & 1, (Corner >> 2) & 1);
		const int3 Texel = clamp(Base + Offset, int3(0, 0, 0), VolumeDimensions - int3(1, 1, 1));
		const uint Status = (bHasStatusTexture == 0) ? 0u : StatusTexture.Load(int4(Texel, 0)).x;
		const uint CornerReason = FlowVizStatusToReason(Status);
		if (CornerReason != FLOWVIZ_REASON_VALID)
		{
			Reason |= CornerReason;
		}
	}
	return (Reason == 0u) ? FLOWVIZ_REASON_VALID : Reason;
}

/** One sample: the scalar, and why it is or is not usable. */
struct FFlowVizSample
{
	float Value;
	uint  Reason;
};

FFlowVizSample FlowVizSampleVolume(float3 LocalPos)
{
	FFlowVizSample Result;
	Result.Value = 0.0f;
	Result.Reason = FLOWVIZ_REASON_UNKNOWN;

	const float3 UVW = FlowVizLocalToUVW(LocalPos);
	if (any(UVW < 0.0f) || any(UVW > 1.0f))
	{
		return Result;
	}

	uint Reason = FlowVizStatusToReason(FlowVizLoadStatus(UVW));

#if !FLOWVIZ_FIELD_UINT
	if (Reason == FLOWVIZ_REASON_VALID && bFilterField != 0 && bStrictStatusFilter != 0)
	{
		Reason = FlowVizStrictCornerReason(UVW);
	}
#endif

	if (Reason != FLOWVIZ_REASON_VALID)
	{
		Result.Reason = Reason;
		return Result;
	}

	const float Value = FlowVizExtractScalar(FlowVizFetchRaw(UVW));

	// Belt and braces: the status volume already says this voxel is finite, but
	// a filtered fetch can straddle one that is not, and an integer format
	// cannot be NaN at all (bRejectNonFinite is 0 there, so this costs nothing).
	if (bRejectNonFinite != 0)
	{
		if (FlowVizIsNaN(Value))
		{
			Result.Reason = FLOWVIZ_REASON_NAN;
			return Result;
		}
		if (!(abs(Value) < 3.402823466e+38f))
		{
			Result.Reason = FLOWVIZ_REASON_INFINITE;
			return Result;
		}
	}

	Result.Value = Value;
	Result.Reason = FLOWVIZ_REASON_VALID;

	// Under and over range are NOT rejections and NOT clamped into the domain:
	// the value stands, and the colour says the transfer function does not
	// cover it (VISUAL_QA rule 4).
	if (ValueRangeMax > ValueRangeMin)
	{
		if (Value < ValueRangeMin) { Result.Reason |= FLOWVIZ_REASON_UNDER_RANGE; }
		if (Value > ValueRangeMax) { Result.Reason |= FLOWVIZ_REASON_OVER_RANGE; }
	}
	return Result;
}

/**
 * Central-difference gradient in LOCAL units.
 *
 * Each axis uses ITS OWN spacing. On the mock domain the three are 0.09375,
 * 0.0625 and 0.0416667; a gradient that divides all three by one number is
 * wrong by up to 2.25x per axis and tilts every shaded normal.
 */
float3 FlowVizGradient(float3 LocalPos)
{
	const float3 H = VoxelSpacing;

	const FFlowVizSample XP = FlowVizSampleVolume(LocalPos + float3(H.x, 0, 0));
	const FFlowVizSample XN = FlowVizSampleVolume(LocalPos - float3(H.x, 0, 0));
	const FFlowVizSample YP = FlowVizSampleVolume(LocalPos + float3(0, H.y, 0));
	const FFlowVizSample YN = FlowVizSampleVolume(LocalPos - float3(0, H.y, 0));
	const FFlowVizSample ZP = FlowVizSampleVolume(LocalPos + float3(0, 0, H.z));
	const FFlowVizSample ZN = FlowVizSampleVolume(LocalPos - float3(0, 0, H.z));

	// 1/(2h) per axis. InvVoxelSpacing carries the reciprocal the CPU computed
	// in double, so this does not redo the division in float.
	return float3(
		(XP.Value - XN.Value) * 0.5f * InvVoxelSpacing.x,
		(YP.Value - YN.Value) * 0.5f * InvVoxelSpacing.y,
		(ZP.Value - ZN.Value) * 0.5f * InvVoxelSpacing.z);
}

/* -------------------------------------------------------------------------- */
/* Transfer function                                                            */
/* -------------------------------------------------------------------------- */

/**
 * LUT lookup. Sampling at u = t reproduces the pixel-centre convention
 * CFDVizColorMaps documents -- entry i sits at (i + 0.5)/N -- which is what
 * makes an Unreal render agree with a matplotlib reference figure.
 */
float4 FlowVizTransferFunction(float Value)
{
	float T = 0.0f;
	if (ValueRangeMax > ValueRangeMin)
	{
		T = (Value - ValueRangeMin) / (ValueRangeMax - ValueRangeMin);
	}
	// The clamp affects only WHICH LUT entry is read. It never changes the
	// reported value, and out-of-range samples are recoloured by the caller.
	T = saturate(T);
	return TransferFunctionTexture.SampleLevel(TransferFunctionSampler, float2(T, 0.5f), 0);
}

/** Colour and opacity for one sample, including the invalid-value policy. */
float4 FlowVizShadeSample(FFlowVizSample Sample)
{
	if ((Sample.Reason & FLOWVIZ_REASON_NAN) != 0u)      { return NaNColor; }
	if ((Sample.Reason & FLOWVIZ_REASON_INFINITE) != 0u) { return NaNColor; }
	if ((Sample.Reason & FLOWVIZ_REASON_MASKED) != 0u)   { return MaskedColor; }
	if ((Sample.Reason & FLOWVIZ_REASON_UNKNOWN) != 0u)  { return NoDataColor; }
	if ((Sample.Reason & FLOWVIZ_REASON_UNDER_RANGE) != 0u) { return UnderRangeColor; }
	if ((Sample.Reason & FLOWVIZ_REASON_OVER_RANGE) != 0u)  { return OverRangeColor; }
	return FlowVizTransferFunction(Sample.Value);
}

/**
 * Gradient lighting.
 *
 * APPLIED TO COLOUR ONLY, AND NEVER TO OPACITY OR TO THE REPORTED VALUE. The
 * Scientific profile forbids lighting that modulates apparent scalar value
 * (VISUAL_QA rule 1); OutValue.x is written from the unlit sample, so a test
 * can assert bit equality between a lit and an unlit render.
 */
float3 FlowVizApplyLighting(float3 BaseColor, float3 LocalPos)
{
	if (bEnableLighting == 0)
	{
		return BaseColor;
	}
	const float3 Gradient = FlowVizGradient(LocalPos);
	const float GradLength = length(Gradient);
	if (!(GradLength > 0.0f))
	{
		return BaseColor * AmbientStrength;
	}
	const float3 Normal = -Gradient / GradLength;
	const float NdotL = saturate(dot(Normal, -normalize(LightDirection)));
	return BaseColor * (AmbientStrength + DiffuseStrength * NdotL);
}

/* -------------------------------------------------------------------------- */
/* Ray setup                                                                    */
/* -------------------------------------------------------------------------- */

/** Intersect a ray with the axis-aligned box [BoxMin, BoxMax]. */
bool FlowVizIntersectBox(float3 Origin, float3 Dir, float3 BoxMin, float3 BoxMax,
	inout float TMin, inout float TMax)
{
	// A zero component gives an infinite slab, which is the correct answer for a
	// ray parallel to that pair of faces, provided the origin is between them.
	const float3 InvDir = 1.0f / Dir;
	const float3 T0 = (BoxMin - Origin) * InvDir;
	const float3 T1 = (BoxMax - Origin) * InvDir;
	const float3 TNear = min(T0, T1);
	const float3 TFar  = max(T0, T1);

	TMin = max(TMin, max(max(TNear.x, TNear.y), TNear.z));
	TMax = min(TMax, min(min(TFar.x, TFar.y), TFar.z));
	return TMax > TMin;
}

/** Narrow [TMin, TMax] by the active clipping planes. */
bool FlowVizApplyClipPlanes(float3 Origin, float3 Dir, inout float TMin, inout float TMax)
{
	const uint Count = min(NumClipPlanes, (uint)FLOWVIZ_MAX_CLIP_PLANES);
	for (uint Index = 0; Index < Count; ++Index)
	{
		const float4 Plane = ClipPlanes[Index];
		const float3 N = Plane.xyz;
		const float Denom = dot(N, Dir);
		const float Dist = dot(N, Origin) + Plane.w;

		if (abs(Denom) < 1e-8f)
		{
			// Parallel. Either the whole ray is kept or the whole ray is gone.
			if (Dist < 0.0f)
			{
				return false;
			}
			continue;
		}

		const float THit = -Dist / Denom;
		if (Denom > 0.0f)
		{
			TMin = max(TMin, THit);   // entering the kept half-space
		}
		else
		{
			TMax = min(TMax, THit);   // leaving it
		}
	}
	return TMax > TMin;
}

/** Cheap decorrelated hash, for the per-ray jitter that breaks step banding. */
float FlowVizHash(uint2 Pixel, uint Seed)
{
	uint N = Pixel.x * 1973u + Pixel.y * 9277u + Seed * 26699u;
	N = (N << 13) ^ N;
	N = N * (N * N * 15731u + 789221u) + 1376312589u;
	return float(N & 0x00FFFFFFu) / 16777216.0f;
}

/* -------------------------------------------------------------------------- */
/* Diagnostic echo                                                              */
/* -------------------------------------------------------------------------- */

/**
 * Write the ten constant-buffer rows back out, one per pixel of row 0.
 *
 * This is the drift detector the cbuffer needs. static_asserts pin the C++
 * offsets against each other; only a round trip through the GPU can show that
 * the shader reads the same bytes the CPU wrote. A member landing in the wrong
 * slot renders a plausible volume and fails here loudly.
 */
void FlowVizWriteDiagnostics(uint2 Pixel)
{
	if (Pixel.y != 0 || Pixel.x >= 10)
	{
		OutValue[Pixel] = float4(0, 0, 0, 0);
		OutColor[Pixel] = float4(0, 0, 0, 0);
		return;
	}

	float4 Row = float4(0, 0, 0, 0);
	switch (Pixel.x)
	{
	case 0: Row = float4(GridOrigin, OriginNarrowingError); break;
	case 1: Row = float4(PhysicalSize, VoxelVolume); break;
	case 2: Row = float4(VoxelSpacing, MinVoxelSpacing); break;
	case 3: Row = float4(InvVoxelSpacing, MaxVoxelSpacing); break;
	case 4: Row = float4(float3(VolumeDimensions), float(ComponentCount)); break;
	case 5: Row = float4(InvVolumeDimensions, float(TextureComponentCount)); break;
	case 6: Row = float4(UVWScale, float(AssociationCode)); break;
	case 7: Row = float4(UVWBias, float(DataTypeCode)); break;
	case 8: Row = float4(float(RequiredStatusMask), float(InvalidStatusMask),
						 float(bHasStatusTexture), float(bHasVectorTexture)); break;
	default: Row = float4(ValueRangeMin, ValueRangeMax,
						  float(bRejectNonFinite), float(PadElementBits)); break;
	}

	OutValue[Pixel] = Row;
	OutColor[Pixel] = Row;
}

/* -------------------------------------------------------------------------- */
/* The ray march                                                                */
/* -------------------------------------------------------------------------- */

[numthreads(FLOWVIZ_THREADS_X, FLOWVIZ_THREADS_Y, 1)]
void FlowVizVolumeRayMarchCS(uint3 DispatchThreadId : SV_DispatchThreadID)
{
	const uint2 Pixel = DispatchThreadId.xy;
	if (Pixel.x >= OutputSizeX || Pixel.y >= OutputSizeY)
	{
		return;
	}

	if (CompositeMode == FLOWVIZ_MODE_DIAGNOSTIC)
	{
		FlowVizWriteDiagnostics(Pixel);
		return;
	}

	/* -- Ray ------------------------------------------------------------- */

	// Pixel centres, so a 1-pixel image samples the middle of the frustum
	// rather than its corner.
	const float2 Screen = float2(
		((float(Pixel.x) + 0.5f) / float(OutputSizeX)) * 2.0f - 1.0f,
		1.0f - ((float(Pixel.y) + 0.5f) / float(OutputSizeY)) * 2.0f);

	float3 Origin;
	float3 Dir;
	if (bOrthographic != 0)
	{
		Origin = RayCameraOrigin
			+ RayCameraRight * (Screen.x * OrthoHalfExtent.x)
			+ RayCameraUp    * (Screen.y * OrthoHalfExtent.y);
		Dir = normalize(RayCameraForward);
	}
	else
	{
		Origin = RayCameraOrigin;
		Dir = normalize(RayCameraForward
			+ RayCameraRight * (Screen.x * TanHalfFov.x)
			+ RayCameraUp    * (Screen.y * TanHalfFov.y));
	}

	// The crop box is a normalised fraction of the domain, so it survives a
	// resolution or spacing change.
	const float3 BoxMin = saturate(min(CropBoxMin, CropBoxMax)) * PhysicalSize;
	const float3 BoxMax = saturate(max(CropBoxMin, CropBoxMax)) * PhysicalSize;

	float TMin = 0.0f;
	float TMax = 3.402823466e+38f;

	float4 Color = float4(0, 0, 0, 0);
	float ReportedValue = 0.0f;
	uint  ReasonBits = FLOWVIZ_REASON_NONE;
	uint  StepsTaken = 0u;

	bool bHit = FlowVizIntersectBox(Origin, Dir, BoxMin, BoxMax, TMin, TMax);
	if (bHit)
	{
		bHit = FlowVizApplyClipPlanes(Origin, Dir, TMin, TMax);
	}

	if (bHit)
	{
		/* -- Step ------------------------------------------------------- */

		// THE ANISOTROPY RULE. The step is in voxel units and is scaled by the
		// SMALLEST spacing, so the thinnest axis is sampled at least once per
		// voxel. Scaling by any other axis undersamples it and aliases.
		const float StepLength = max(StepVoxels, 1e-6f) * MinVoxelSpacing;
		const float ReferenceLength = max(ReferenceStepVoxels, 1e-6f) * MinVoxelSpacing;
		const float OpacityCorrection = StepLength / ReferenceLength;

		float T = max(TMin, 0.0f);
		if (bEnableJitter != 0)
		{
			// Sub-step offset only: it moves where samples land, never how many
			// there are, so it cannot change the reported extent of the data.
			T += FlowVizHash(Pixel, JitterSeed) * saturate(JitterAmount) * StepLength;
		}

		float MaxValue = -3.402823466e+38f;
		float MinValue =  3.402823466e+38f;
		float SumValue = 0.0f;
		uint  ValidCount = 0u;

		float PrevSigned = 0.0f;
		float PrevT = T;
		bool  bHavePrev = false;
		bool  bIsoFound = false;
		// A separate flag, not "ReportedValue == 0": a field whose first valid
		// sample IS zero is ordinary data, and testing the value would make the
		// renderer report the SECOND sample there. Zero is a value, not a state.
		bool  bHaveReported = false;

		const uint StepLimit = max(MaxSteps, 1u);

		LOOP
		for (uint Step = 0; Step < StepLimit; ++Step)
		{
			if (T > TMax)
			{
				break;
			}
			++StepsTaken;

			const float3 LocalPos = Origin + Dir * T;
			const FFlowVizSample Sample = FlowVizSampleVolume(LocalPos);
			ReasonBits |= Sample.Reason;

			const bool bUsable = (Sample.Reason & FLOWVIZ_REASON_VALID) != 0u;

			if (bUsable)
			{
				++ValidCount;
				MaxValue = max(MaxValue, Sample.Value);
				MinValue = min(MinValue, Sample.Value);
				SumValue += Sample.Value;
			}

			if (CompositeMode == FLOWVIZ_MODE_ISOSURFACE)
			{
				if (bUsable)
				{
					const float Signed = Sample.Value - IsoValue;
					if (bHavePrev && (Signed == 0.0f || (PrevSigned * Signed) < 0.0f))
					{
						// Linear crossing between the bracketing samples. The
						// surface is where the field equals IsoValue, not where
						// the nearest sample happened to land, so this is what
						// keeps an iso-surface off the sample lattice and free
						// of stair-stepping.
						const float Alpha = (Signed == PrevSigned)
							? 0.0f
							: (-PrevSigned / (Signed - PrevSigned));
						const float THit = PrevT + Alpha * (T - PrevT);
						const float3 HitPos = Origin + Dir * THit;

						ReportedValue = IsoValue;
						float4 Shaded = FlowVizTransferFunction(IsoValue);
						Shaded.rgb = FlowVizApplyLighting(Shaded.rgb, HitPos);
						Color = float4(Shaded.rgb, 1.0f);
						bIsoFound = true;
						break;
					}
					PrevSigned = Signed;
					PrevT = T;
					bHavePrev = true;
				}
				else if ((Sample.Reason & FLOWVIZ_REASON_UNKNOWN) == 0u)
				{
					// An explicitly invalid voxel is drawn, not skipped: it is
					// data the surface cannot cross, and hiding it would make
					// the hole look like empty space.
					const float4 Invalid = FlowVizShadeSample(Sample);
					if (Invalid.a > 0.0f)
					{
						Color = float4(Invalid.rgb, 1.0f);
						break;
					}
				}
			}
			else if (CompositeMode == FLOWVIZ_MODE_ALPHA)
			{
				float4 Shaded = FlowVizShadeSample(Sample);
				if (!bUsable && (Sample.Reason & FLOWVIZ_REASON_UNKNOWN) != 0u)
				{
					// Absent, not invalid. Empty space contributes nothing.
					Shaded.a *= NoDataColor.a;
				}

				float Alpha = saturate(Shaded.a * OpacityMultiplier);
				if (Alpha > 0.0f)
				{
					// Step-size correction, so halving the step does not double
					// the apparent density. Without it the image depends on a
					// performance setting, which is not a defensible figure.
					Alpha = 1.0f - pow(max(1.0f - Alpha, 1e-6f), OpacityCorrection);

					float3 Rgb = Shaded.rgb;
					if (bUsable)
					{
						Rgb = FlowVizApplyLighting(Rgb, LocalPos);
					}

					// Front to back.
					Color.rgb += (1.0f - Color.a) * Alpha * Rgb;
					Color.a   += (1.0f - Color.a) * Alpha;

					if (bUsable && !bHaveReported)
					{
						// The first valid sample the ray composites is what the
						// pixel reports. Written BEFORE any lighting term, which
						// is what lets a lit and an unlit render be compared bit
						// for bit (VISUAL_QA rule 1).
						ReportedValue = Sample.Value;
						bHaveReported = true;
					}

					// Early ray termination.
					if (Color.a >= EarlyTerminationAlpha)
					{
						break;
					}
				}
			}

			T += StepLength;
		}

		/* -- Resolve ---------------------------------------------------- */

		if (CompositeMode == FLOWVIZ_MODE_MAXIMUM
			|| CompositeMode == FLOWVIZ_MODE_MINIMUM
			|| CompositeMode == FLOWVIZ_MODE_AVERAGE)
		{
			if (ValidCount > 0u)
			{
				if (CompositeMode == FLOWVIZ_MODE_MAXIMUM)      { ReportedValue = MaxValue; }
				else if (CompositeMode == FLOWVIZ_MODE_MINIMUM) { ReportedValue = MinValue; }
				else                                            { ReportedValue = SumValue / float(ValidCount); }

				FFlowVizSample Projected;
				Projected.Value = ReportedValue;
				Projected.Reason = FLOWVIZ_REASON_VALID;
				if (ValueRangeMax > ValueRangeMin)
				{
					if (ReportedValue < ValueRangeMin) { Projected.Reason |= FLOWVIZ_REASON_UNDER_RANGE; }
					if (ReportedValue > ValueRangeMax) { Projected.Reason |= FLOWVIZ_REASON_OVER_RANGE; }
				}
				const float4 Shaded = FlowVizShadeSample(Projected);
				Color = float4(Shaded.rgb, 1.0f);
			}
			else if (ReasonBits != FLOWVIZ_REASON_NONE)
			{
				// No usable sample anywhere along the ray. Show WHY, in the
				// order of specificity, rather than showing empty space.
				FFlowVizSample Failed;
				Failed.Value = 0.0f;
				Failed.Reason = ReasonBits;
				const float4 Shaded = FlowVizShadeSample(Failed);
				if (Shaded.a > 0.0f)
				{
					Color = float4(Shaded.rgb, 1.0f);
				}
			}
		}
		else if (CompositeMode == FLOWVIZ_MODE_ISOSURFACE && !bIsoFound && Color.a == 0.0f)
		{
			ReportedValue = 0.0f;
		}
	}

	OutColor[Pixel] = Color;
	OutValue[Pixel] = float4(ReportedValue, Color.a, float(ReasonBits), float(StepsTaken));
}
