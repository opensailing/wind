//
// Shared declarations for FlowViz shaders, included as:
//
//     #include "/Plugin/FlowViz/FlowVizCommon.ush"
//
// FlowVizRuntime.cpp maps /Plugin/FlowViz to this directory during
// StartupModule. That mapping asserts the directory exists, so this file also
// serves as the thing that keeps the directory in git: an empty Shaders/ is
// untracked, and a checkout without it crashes the module before any test
// runs. Tools/tests/test_checkout_is_complete.sh pins that.

#pragma once

// Volume fields are stored in _UINT texture formats, never UNORM (ADR 002 and
// Render/FlowVizVolumeTexture.cpp). A UNORM sampler would hand the shader
// value/255 and a quantised field would arrive silently rescaled, so integer
// samples are converted here, explicitly, where the scale factor is visible.
#define FLOWVIZ_UNORM8_SCALE  (1.0f / 255.0f)
#define FLOWVIZ_UNORM16_SCALE (1.0f / 65535.0f)

// A 3-component field widens to 4 channels on upload -- there is no portable
// 3-channel 3D texture format -- and the pad channel carries a quiet NaN so a
// shader that reads it gets an obviously wrong number rather than a plausible
// zero. Anything reading .w from a widened field is a bug; this makes it one
// that shows up on screen.
#define FLOWVIZ_PAD_IS_NAN 1

// True when the sampled value is a NaN, including the pad channel above.
//
// Tested on the BIT PATTERN, not with a comparison. The obvious spelling is the
// self-comparison !(Value == Value), and this function used to be written that
// way, with a comment asserting the form "survives fast-math". It does not.
// Fast-math permits the compiler to assume no operand is a NaN, which makes
// Value == Value a tautology it is free to fold to true - so the function
// returned false for every NaN it was ever given, and every NaN fell through to
// the range test below it and was reported as an INFINITY. That is not a
// cosmetic mislabel: an infinity is how CVF 4.4.7 spells a deliberate "no data
// here", so a diverged solver was being reported as an intentionally empty
// region. FlowViz.Render.ReasonChannel renders an all-NaN field and asserts the
// reason is NaN and not INFINITE, which is the assertion that caught this.
//
// isnan() is not the fix either: it is unavailable in some Metal shader stages,
// which is what drove the original spelling, and where it is available
// fast-math is equally entitled to fold it.
//
// asuint has no floating-point semantics for the optimiser to reason about, so
// no fast-math assumption applies. A NaN is exponent all-ones with a non-zero
// mantissa; an infinity is exponent all-ones with a mantissa of zero, which is
// what keeps the two causes distinguishable here.
bool FlowVizIsNaN(float Value)
{
	const uint Bits = asuint(Value);
	return ((Bits & 0x7F800000u) == 0x7F800000u) && ((Bits & 0x007FFFFFu) != 0u);
}
